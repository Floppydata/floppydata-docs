{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "FloppyData Client API",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "openapi": [
      "api-reference/openapi.json",
      "api-reference/openapi-v1.json"
    ],
    "playground": {
      "display": "interactive"
    },
    "url": "full",
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.floppydata.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://app.floppydata.com/settings/account"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "pages": [
          "product-overview",
          "authentication",
          "quickstart",
          "development"
        ]
      },
      {
        "tab": "Proxies",
        "pages": [
          "proxies/basics",
          "proxies/using-proxies",
          "proxies/troubleshooting",
          "proxies/browser-and-extension-setup"
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "root": "api-reference/introduction",
            "pages": []
          },
          {
            "group": "Web Data",
            "root": "api-reference/v2/endpoint/web-data-fetch",
            "pages": [
              "api-reference/v2/endpoint/web-data-balance",
              "api-reference/v2/endpoint/web-data-usage"
            ]
          },
          {
            "group": "Rotating proxy",
            "root": "api-reference/v2/endpoint/rotating-connection",
            "pages": [
              "api-reference/v2/endpoint/rotating-locations",
              "api-reference/v2/endpoint/rotating-balance",
              "api-reference/v2/endpoint/rotating-usage"
            ]
          },
          {
            "group": "Static proxy",
            "root": "api-reference/v2/endpoint/static-proxies",
            "pages": []
          },
          {
            "group": "Proxy",
            "root": "api-reference/v2/endpoint/check-proxy",
            "pages": []
          },
          {
            "group": "Account",
            "root": "api-reference/v2/endpoint/account-balances",
            "pages": [
              "api-reference/v2/endpoint/account-usage"
            ]
          },
          {
            "group": "Legacy v1",
            "root": "api-reference/v1/endpoint/rotating-balance",
            "pages": [
              "api-reference/v1/endpoint/rotating-locations",
              "api-reference/v1/endpoint/rotating-smart-params-builder",
              "api-reference/v1/endpoint/rotating-smart-params-credentials",
              "api-reference/v1/endpoint/rotating-statistics",
              "api-reference/v1/endpoint/static-list",
              "api-reference/v1/endpoint/web-unlocker",
              "api-reference/v1/endpoint/web-unlocker-balance",
              "api-reference/v1/endpoint/check-proxy"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "By product",
            "root": "guides/rotating-proxy",
            "pages": [
              "guides/static-ips",
              "guides/web-data",
              "guides/check-proxy"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Floppydata/floppydata-docs"
    }
  }
}
