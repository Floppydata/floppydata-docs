{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Floppydata Client API",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "openapi": [
      "api-reference/openapi.json",
      "api-reference/openapi-v1.json"
    ],
    "playground": {
      "display": "interactive"
    },
    "url": "full",
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.floppydata.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://app.floppydata.com/settings/account"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Start",
        "pages": [
          "quickstart",
          "authentication",
          "development"
        ]
      },
      {
        "tab": "Sandbox",
        "pages": [
          "sandbox"
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Core API tasks",
            "root": "guides/web-data",
            "pages": [
              "guides/rotating-proxy",
              "guides/static-ips",
              "guides/balances-usage",
              "guides/check-proxy"
            ]
          },
          {
            "group": "Proxy setup",
            "root": "proxies/basics",
            "pages": [
              "proxies/using-proxies",
              "proxies/browser-and-extension-setup",
              "proxies/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "root": "api-reference/introduction",
            "pages": []
          },
          {
            "group": "v2",
            "pages": [
              {
                "group": "web-data",
                "pages": [
                  "api-reference/v2/endpoint/web-data-fetch",
                  "api-reference/v2/endpoint/web-data-balance",
                  "api-reference/v2/endpoint/web-data-usage"
                ]
              },
              {
                "group": "proxy",
                "pages": [
                  {
                    "group": "rotating",
                    "pages": [
                      "api-reference/v2/endpoint/rotating-connection",
                      "api-reference/v2/endpoint/rotating-locations",
                      "api-reference/v2/endpoint/rotating-balance",
                      "api-reference/v2/endpoint/rotating-usage"
                    ]
                  },
                  {
                    "group": "static",
                    "pages": [
                      "api-reference/v2/endpoint/static-proxies"
                    ]
                  },
                  "api-reference/v2/endpoint/check-proxy"
                ]
              },
              {
                "group": "account",
                "pages": [
                  "api-reference/v2/endpoint/account-balances",
                  "api-reference/v2/endpoint/account-usage"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Legacy v1",
        "pages": [
          "legacy-v1"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Floppydata/floppydata-docs"
    }
  }
}
